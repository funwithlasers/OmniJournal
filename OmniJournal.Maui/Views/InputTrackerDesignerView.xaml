<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OmniJournal.Maui.Views.InputTrackerDesignerView"
             xmlns:models="clr-namespace:OmniJournal.Core.Models;assembly=OmniJournal.Core"
             x:DataType="models:TrackerDesigner" >

    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label Text="Input Label. not funny" />
            <Entry Text="{Binding Name}" FontSize="20" />
            <Label Text="{Binding TrackerType}" FontSize="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
