<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OmniJournal.Maui"
             xmlns:models="clr-namespace:OmniJournal.Core.Models;assembly=OmniJournal.Core"
             xmlns:views="clr-namespace:OmniJournal.Maui.Views"
             x:Class="OmniJournal.Maui.TrackerDesignerPage">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="10">
            <Picker x:Name="trackerTypePicker"
                Title="Select Template"
                ItemsSource="{Binding TrackerTypes}"
                SelectedIndexChanged="OnTrackerTypeSelectedIndexChanged" />

            <!--<views:RankTrackerDesignerView />-->
            <ContentPresenter x:Name="contentPresenter" />

        </VerticalStackLayout>
    </ScrollView>
 
</ContentPage>
